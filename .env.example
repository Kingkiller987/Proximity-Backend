# ==============================================================================
# Proximity Backend Environment Configuration Template
# Copy this file to .env and adjust values for your local development setup.
# NEVER commit .env to version control or hardcode secrets in code.
# ==============================================================================

# Application Environment Mode (development | production)
ENV=development

# PostgreSQL & PostGIS Database Configuration
POSTGRES_USER=proximity
POSTGRES_PASSWORD=proximity_local_dev_password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=proximity
POSTGRES_TEST_DB=proximity_test

# JWT & Authentication Signing Key
# WARNING: In production, generate a secure random 64-character secret.
# Never reuse local development signing keys in production environments.
SECRET_KEY=proximity-local-dev-secret-key-change-in-production-abc123xyz
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Protected Media Storage
# Directory where uploaded images and attachments are securely stored.
MEDIA_STORAGE_DIR=./storage/media
MAX_IMAGE_BYTES=5242880

# Server-Authoritative Location Verification Thresholds
# Rejects GPS fixes older than 30s or with accuracy worse than 50m.
MAX_LOCATION_AGE_SECONDS=30
MAX_GPS_ACCURACY_METERS=50.0
